# ---- Django ----
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (Neon) ----
# Neon dashboard -> Connection string -> "psycopg" / URI form.
# Keep the ?sslmode=require that Neon appends.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://usjobplacement.zapkitt.com,http://localhost:3000

# ---- Email (Resend) ----
RESEND_API_KEY=
# Must be a domain verified in Resend. gmail.com can never be verified.
EMAIL_FROM=ZapKitt Placement <noreply@zapkitt.com>
EMAIL_REPLY_TO=aidropshq@gmail.com
NOTIFY_TEAM_EMAILS=aidropshq@gmail.com

# ---- WhatsApp ----
# provider=callmebot : free, no Meta account, works in minutes. Unofficial
#   third party, so the alert carries ONLY a lead id — never candidate data.
#   Get a key by messaging "I allow callmebot to send me messages" to the
#   CallMeBot number from the WhatsApp account that should receive alerts.
# provider=meta      : official Cloud API. Needs a Meta Business Account, a
#   verified sender and approved templates. Days, not minutes.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=callmebot
CALLMEBOT_API_KEY=
# Full international form, digits only, no + and no spaces. Comma-separated.
NOTIFY_TEAM_WHATSAPP=

# Only used when WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LEAD=

# ---- Admin bootstrap (Render free tier has no Shell) ----
# Set these, deploy once, then DELETE the password variable.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=aidropshq@gmail.com
DJANGO_SUPERUSER_PASSWORD=

# ---- Misc ----
SITE_URL=https://usjobplacement.zapkitt.com
ADMIN_URL=https://usjobplacement-api.onrender.com/admin/
API_THROTTLE_ANON=12/hour
LOG_LEVEL=INFO
