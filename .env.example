# Django API (phase 03). Local: http://127.0.0.1:8000
# Production: the Render service URL for the Django backend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public site origin, used for metadataBase, sitemap and OG URLs.
NEXT_PUBLIC_SITE_URL=https://usjobplacement.zapkitt.com

# Calendly inline embed (phase 03).
NEXT_PUBLIC_CALENDLY_URL=

# WhatsApp broadcast channel shown in the footer.
# NEXT_PUBLIC_* is inlined at BUILD time — set it in Vercel and redeploy.
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
