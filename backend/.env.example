# ---- Django ----
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (Neon) ----
# Neon dashboard -> Connection string -> "psycopg" / URI form.
# Keep the ?sslmode=require that Neon appends.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://usjobplacement.zapkitt.com,http://localhost:3000

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=ZapKitt Placement <hello@zapkitt.com>
EMAIL_REPLY_TO=hello@zapkitt.com
NOTIFY_TEAM_EMAILS=hello@zapkitt.com

# ---- WhatsApp (off until Meta Business is set up) ----
# Business-initiated messages need a verified sender and APPROVED templates.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LEAD=
NOTIFY_TEAM_WHATSAPP=

# ---- Misc ----
SITE_URL=https://usjobplacement.zapkitt.com
API_THROTTLE_ANON=12/hour
LOG_LEVEL=INFO
